{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListerPublic",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::iam-policies-sensor-1",
      "Condition": { "StringLike": { "s3:prefix": ["public/*"] } }
    },
    {
      "Sid": "LireEcrirePublic",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::iam-policies-sensor-1/public/*"
    }
  ]
}
