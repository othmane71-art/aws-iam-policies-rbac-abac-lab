{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListerRapports",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::iam-policies-sensor-1",
      "Condition": { "StringLike": { "s3:prefix": ["rapports/*"] } }
    },
    {
      "Sid": "LireRapports",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::iam-policies-sensor-1/rapports/*"
    }
  ]
}
